menu "ESP32 MPU6050 MQTT Configuration"

    menu "Wi-Fi Configuration"
        config WIFI_SSID
            string "WiFi SSID"
            default "myssid"
            help
                SSID (network name) for the ESP32 to connect to.

        config WIFI_PASSWORD
            string "WiFi Password"
            default "mypassword"
            help
                WiFi password (WPA or WPA2) for the ESP32 to use.

        config WIFI_MAX_RETRY
            int "Maximum retry"
            default 5
            help
                Set the Maximum retry to avoid station reconnecting to the AP unlimited when the AP is really inexistent.
    endmenu

    menu "MQTT Configuration"
        config MQTT_BROKER_URL
            string "Broker URL"
            default "mqtt://192.168.1.100:1883"
            help
                URL of the MQTT broker to connect to (WatchTower Jetson)

        config MQTT_TOPIC_SENSOR_DATA
            string "Sensor Data Topic"
            default "joystick/sensor/data"
            help
                MQTT topic for publishing joystick sensor data (WatchTower protocol)

        config MQTT_TOPIC_STATUS
            string "Status Topic"
            default "joystick/status"
            help
                MQTT topic for publishing joystick status

        config MQTT_TOPIC_COMMAND
            string "Command Topic"
            default "watchtower/command/joystick"
            help
                MQTT topic for receiving commands from WatchTower
    endmenu

    config BROKER_URL_FROM_STDIN
        bool
        default y if MQTT_BROKER_URL = "FROM_STDIN"

endmenu
