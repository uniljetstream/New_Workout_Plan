# WatchTower 환경 변수 설정 예시
# 이 파일을 복사하여 .env 파일을 만들고 실제 값으로 수정하세요
# cp .env.example .env

# ============================================
# AI 서버 설정
# ============================================
AI_SERVER_HOST=192.168.1.100
AI_SERVER_PORT=5000

# ============================================
# MQTT 브로커 설정
# ============================================
MQTT_BROKER_HOST=10.10.16.111
MQTT_BROKER_PORT=1883

# MQTT 인증 (필요시 설정)
MQTT_USERNAME=
MQTT_PASSWORD=
