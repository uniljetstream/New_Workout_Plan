menu "Workout MQTT 설정"

config WORKOUT_MQTT_ENABLED
    bool "워크아웃 MQTT 사용"
    default y

if WORKOUT_MQTT_ENABLED

config WORKOUT_MQTT_BROKER_URI
    string "MQTT 브로커 URI"
    default "mqtt://10.10.16.111:1883"
    help
        MQTT 브로커 주소를 입력하세요. 예: mqtt://example.com:1883 또는 mqtts://example.com:8883

config WORKOUT_MQTT_CLIENT_ID
    string "MQTT 클라이언트 ID"
    default "esp32-heart-rate"

config WORKOUT_MQTT_USERNAME
    string "MQTT 사용자 이름 (토큰)"
    default ""
    help
        API 토큰을 사용자 이름 또는 비밀번호로 요구할 경우 여기에 입력합니다.

config WORKOUT_MQTT_PASSWORD
    string "MQTT 비밀번호"
    default ""

config WORKOUT_MQTT_TOPIC_HEART_RATE
    string "심박수 발행 토픽"
    default "esp32/sensor/data"

config WORKOUT_MQTT_QOS
    int "심박수 메시지 QoS"
    range 0 2
    default 1

config WORKOUT_MQTT_KEEPALIVE_SEC
    int "MQTT Keepalive (초)"
    range 15 600
    default 60

config WORKOUT_MQTT_CERT_PEM
    string "MQTT 브로커 CA 인증서 (PEM)"
    default ""
    help
        TLS 브로커에 접속할 경우 PEM 형식의 CA 인증서를 붙여 넣습니다.

endif # WORKOUT_MQTT_ENABLED

endmenu
