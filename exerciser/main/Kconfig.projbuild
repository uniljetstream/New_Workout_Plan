menu "Exerciser Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default "your_wifi_ssid"
        help
            SSID (network name) for the exerciser to connect to.

    config WIFI_PASSWORD
        string "WiFi Password"
        default "your_wifi_password"
        help
            WiFi password (WPA or WPA2) for the exerciser to use.

    config WIFI_MAX_RETRY
        int "Maximum retry"
        default 5
        help
            Set the Maximum retry to avoid station reconnecting to the AP unlimited when the AP is really inexistent.

    config MQTT_BROKER_URL
        string "MQTT Broker URL"
        default "mqtt://10.10.16.111"
        help
            URL of the MQTT broker to connect to (mqtt://hostname or mqtts://hostname).

    config MQTT_TOPIC_COMMAND
        string "MQTT Command Topic"
        default "watchtower/command/joystick"
        help
            MQTT topic for receiving commands from WatchTower (same as joystick).

    config MQTT_TOPIC_STATUS
        string "MQTT Status Topic"
        default "exerciser/status"
        help
            MQTT topic for publishing exerciser status.

endmenu
